# Copy to .env (auto-loaded by run.py / main.py via python-dotenv).
#
# --- gateway + identity (read by the SDK: AmebaAI.from_env) ---
# One URL is enough: porin serves llm / asr / tts / embeddings, and
# AMEBA_BASE_URL back-fills every per-kind URL that is left unset.
#   from a dev box:  http://<Console address>/porin/<site slug>   (lab: http://10.101.133.88/porin/k8s-ran;
#                    a bare /porin answers 404)
#   in-cluster:      http://porin-ai-gateway-svc.default.svc.cluster.local:8080
AMEBA_BASE_URL=http://<Console address>/porin/<site slug>
AMEBA_API_KEY=bsa_...                       # POST /v1/register on the gateway to mint one
# Pick a model first — list what your cluster actually serves (entries with
# "type": "llm"), then fill it in; the lineup changes over time:
#   curl http://<Console address>/porin/<site slug>/v1/models -H "Authorization: Bearer <your bsa_ key>"
AMEBA_LLM_MODEL=Qwen/Qwen2.5-Omni-7B        # example — verify against /v1/models
AMEBA_APP_NAME=hello-world

# --- optional per-kind overrides (only if a service lives on another host) ---
# AMEBA_LLM_BASE_URL=
# AMEBA_ASR_BASE_URL=
# AMEBA_TTS_BASE_URL=

# --- server / ops ---
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true       # dev box only: hot-reload on code edits (off in the container)
