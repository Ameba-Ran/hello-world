# Copy to .env — run.py loads it at startup (the SDK itself reads only the
# environment).
#
# The Console fills these in for you: API & Keys › AI API › AI SDK. Pick the
# site and the model there, then copy the three values.
AMEBA_BASE_URL=http://<Console address>/heimdall/<site slug>/v1
AMEBA_API_KEY=<your key>
# A model id from GET <Base URL>/models. Comments go on their own line:
# docker run --env-file keeps anything after the = as the value.
AMEBA_LLM_MODEL=<model>
AMEBA_APP_NAME=hello-world

# --- server ---
# HOST=0.0.0.0
# PORT=8000
# Dev box only: hot-reload on code edits (off in the container).
# RELOAD=true
